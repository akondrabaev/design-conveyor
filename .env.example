# Copy to .env and fill in. .env is git-ignored.

# Google Gemini API key (paid tier: the free tier has no image-generation quota)
GEMINI_API_KEY=your-gemini-api-key

# Your brand: used in prompts ("the ACME logo", letters A-C-M-E), specs, file names and the UI header
BRAND_NAME=BRAND

# Optional model overrides
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Optional: reach Gemini through a relay (regions where Google AI is not available), see deploy/gemini-relay/
# GEMINI_BASE_URL=https://gemini-relay.<your-account>.workers.dev
# RELAY_SECRET=long-random-string
